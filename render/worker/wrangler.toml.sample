# Copy to wrangler.toml. NOT DEPLOYED.
name = "yardplan-render"
main = "src/worker.js"
compatibility_date = "2026-10-01"
# npx wrangler kv namespace create RENDER_KV   (paste id)
kv_namespaces = [{ binding = "RENDER_KV", id = "REPLACE_WITH_KV_NAMESPACE_ID" }]
# Optional result/input storage: npx wrangler r2 bucket create yardplan-renders
# r2_buckets = [{ binding = "IMAGES", bucket_name = "yardplan-renders" }]

[vars]
ALLOWED_ORIGINS = "https://yardplan.example.com,http://localhost:8080"
PROVIDERS = "xai,fal-kontext"     # paid (default): xAI primary, fal Kontext fallback
ALLOW_FREE = "false"              # free adapters are off; set "true" AND add "free" to PROVIDERS to opt in
FREE_PROVIDERS = "cf-img2img"      # what "free" expands to: cf-img2img | hf-space | pollinations (comma list)
FREE_DAILY_CAP = "50"              # per free provider per day
ALLOW_NONCOMMERCIAL = "false"      # "true" only for private testing (enables FLUX.1 Kontext [dev] Space, Pollinations)
HF_SPACE_KIND = "qwen2509"         # kontext (non-commercial) | qwen2509 | qwen (Apache-2.0); HF_SPACE_URL to point at your own Space
# Workers AI binding for cf-img2img (free allocation):
# [ai]
# binding = "AI"
DAILY_BUDGET_USD = "2"            # hard-ish cap across all users (KV best effort)
ALLOW_MOCK = "false"
STORE_RESULTS = "false"           # "true" + IMAGES binding = save results in R2, return /api/render/img/<key>
# Secrets (never here):  npx wrangler secret put XAI_API_KEY ; FAL_KEY ; optional HF_TOKEN (free HF account = 5 ZeroGPU min/day) ; POLLINATIONS_KEY
